{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "bocg.operating-unit-register/v1"
    },
    "contract_version": {
      "const": "1.0.0"
    },
    "dataset_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,199}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "previous_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,199}$"
    },
    "plane": {
      "enum": [
        "record",
        "synthetic"
      ]
    },
    "owner_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "bocg": {
      "$ref": "#/$defs/dependency"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "units": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/unit"
      }
    },
    "assignments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assignment"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationship"
      }
    },
    "settings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/setting"
      }
    }
  },
  "required": [
    "schema",
    "contract_version",
    "dataset_id",
    "revision",
    "previous_sha256",
    "tenant_id",
    "plane",
    "owner_ref",
    "recorded_at",
    "bocg",
    "sources",
    "units",
    "assignments",
    "relationships",
    "settings"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/thefazzer/bankingops-coverage-grid/blob/main/specs/operating-unit-register.schema.json",
  "title": "Consumer-owned operating unit reference register; definition only",
  "$defs": {
    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "PROPOSED",
            "REVIEWED",
            "REJECTED"
          ]
        },
        "reviewer_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      },
      "required": [
        "status",
        "reviewer_ref",
        "reviewed_at",
        "reason"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "REVIEWED",
                  "REJECTED"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "reviewer_ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "reviewed_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      ]
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entity_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,199}$"
        },
        "entity_type": {
          "enum": [
            "organization",
            "person",
            "account",
            "system",
            "location",
            "role",
            "calendar",
            "reference_dataset"
          ]
        },
        "issuer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      },
      "required": [
        "entity_id",
        "entity_type",
        "issuer"
      ]
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "unit_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,199}$"
        },
        "kind": {
          "enum": [
            "business_unit",
            "desk",
            "team"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "legal_entity": {
          "$ref": "#/$defs/entity"
        },
        "parent_unit_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "canonical_entity_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "valid_from": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "valid_to": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,199}$"
          }
        },
        "review": {
          "$ref": "#/$defs/review"
        }
      },
      "required": [
        "unit_id",
        "kind",
        "label",
        "legal_entity",
        "parent_unit_id",
        "canonical_entity_id",
        "valid_from",
        "valid_to",
        "evidence_refs",
        "review"
      ]
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assignment_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,199}$"
        },
        "unit_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,199}$"
        },
        "reference_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,199}$"
        },
        "relationship": {
          "enum": [
            "performs",
            "supports"
          ]
        },
        "valid_from": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "valid_to": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,199}$"
          }
        },
        "review": {
          "$ref": "#/$defs/review"
        }
      },
      "required": [
        "assignment_id",
        "unit_id",
        "reference_id",
        "relationship",
        "valid_from",
        "valid_to",
        "evidence_refs",
        "review"
      ]
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "relationship_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,199}$"
        },
        "unit_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,199}$"
        },
        "predicate": {
          "enum": [
            "owns_book",
            "uses_system",
            "has_member",
            "has_owner",
            "located_at",
            "uses_calendar",
            "uses_reference_dataset"
          ]
        },
        "target": {
          "$ref": "#/$defs/entity"
        },
        "valid_from": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "valid_to": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,199}$"
          }
        },
        "review": {
          "$ref": "#/$defs/review"
        }
      },
      "required": [
        "relationship_id",
        "unit_id",
        "predicate",
        "target",
        "valid_from",
        "valid_to",
        "evidence_refs",
        "review"
      ]
    },
    "setting": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "setting_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,199}$"
        },
        "unit_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,199}$"
        },
        "key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,199}$"
        },
        "value_type": {
          "enum": [
            "number",
            "text",
            "boolean",
            "reference",
            "json"
          ]
        },
        "value": {},
        "scope": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "owner_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "valid_from": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "valid_to": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,199}$"
          }
        },
        "review": {
          "$ref": "#/$defs/review"
        }
      },
      "required": [
        "setting_id",
        "unit_id",
        "key",
        "value_type",
        "value",
        "scope",
        "owner_ref",
        "valid_from",
        "valid_to",
        "evidence_refs",
        "review"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,199}$"
        },
        "kind": {
          "enum": [
            "canonical_record",
            "governed_reference",
            "authored_fixture"
          ]
        },
        "locator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "source_id",
        "kind",
        "locator",
        "sha256",
        "observed_at"
      ]
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "release_tag": {
          "type": "string",
          "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "catalogue_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "contract_version": {
          "const": "1.0.0"
        }
      },
      "required": [
        "release_tag",
        "manifest_sha256",
        "catalogue_sha256",
        "contract_version"
      ]
    }
  }
}
