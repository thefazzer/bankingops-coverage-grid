{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/thefazzer/bankingops-coverage-grid/blob/main/specs/institutional-speech-act.schema.json",
  "title": "BOCG institutional speech-act expansion",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "literal_speech_act", "institutional_speech_act", "pragmatic_expansion", "obligation_frame", "state_separation_enforced"],
  "properties": {
    "schema": {"const": "kg-institutional-speech-act-expansion.v1"},
    "literal_speech_act": {"$ref": "#/$defs/SpeechAct"},
    "institutional_speech_act": {"$ref": "#/$defs/SpeechAct"},
    "pragmatic_expansion": {
      "type": "object", "additionalProperties": true,
      "required": ["expanded_reading", "basis", "adjudication_status"],
      "properties": {
        "expanded_reading": {"type": "string", "minLength": 12},
        "basis": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "adjudication_status": {"const": "sme_confirmed"}
      }
    },
    "obligation_frame": {
      "type": "object", "additionalProperties": true,
      "required": ["directive_status", "execution_status", "completion_status", "verification_status"],
      "properties": {
        "directive_status": {"enum": ["directed", "not_observed", "unknown"]},
        "execution_status": {"enum": ["not_observed", "pending", "scheduled", "unknown"]},
        "completion_status": {"enum": ["not_observed", "unknown"]},
        "verification_status": {"enum": ["not_observed", "unknown"]}
      }
    },
    "state_separation_enforced": {"const": true},
    "expansion_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "SpeechAct": {
      "type": "object", "additionalProperties": true, "required": ["type"],
      "properties": {"type": {"enum": ["directive", "information_request", "confirmation_request", "commitment", "acknowledgement", "assertion"]}}
    }
  }
}
