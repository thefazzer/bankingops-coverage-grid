{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/thefazzer/bankingops-coverage-grid/blob/main/specs/replayable-compliance-scenario.schema.json",
  "title": "BOCG replayable compliance scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "scenario_id",
    "scenario_hash",
    "bocg_release",
    "cell_ref",
    "task_ref",
    "input_state",
    "oracle",
    "expected_verdict"
  ],
  "properties": {
    "schema": {
      "const": "bocg.replayable-compliance-scenario.v1"
    },
    "scenario_id": {
      "type": "string",
      "pattern": "^scenario_[a-z0-9_]{3,128}$"
    },
    "scenario_hash": {
      "$ref": "#/$defs/sha256"
    },
    "bocg_release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_sha256", "release_tag"],
      "properties": {
        "manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "release_tag": {
          "type": "string",
          "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "cell_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cell_id", "cell_sha256"],
      "properties": {
        "cell_id": {
          "type": "string",
          "pattern": "^cp_[a-z0-9_]{3,64}$"
        },
        "cell_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "task_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["division_key", "reference_id"],
      "properties": {
        "division_key": {
          "type": "string"
        },
        "reference_id": {
          "type": "string",
          "pattern": "^task:[A-Za-z0-9_]+:[0-9a-f]{24}$"
        }
      }
    },
    "input_state": {
      "type": "object",
      "additionalProperties": true,
      "required": ["description", "facts"],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 10
        },
        "facts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["name", "value_type"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "value_type": {
                "enum": [
                  "string",
                  "number",
                  "boolean",
                  "date",
                  "identifier",
                  "reference"
                ]
              },
              "value": {},
              "source": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "public_reference"],
      "properties": {
        "kind": {
          "enum": [
            "regulatory_clause",
            "standard_rule_set",
            "reference_table",
            "deterministic_function"
          ]
        },
        "public_reference": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_name", "url", "clause", "accessed"],
          "properties": {
            "source_name": {
              "type": "string"
            },
            "url": {
              "type": "string",
              "pattern": "^https?://"
            },
            "clause": {
              "type": "string"
            },
            "accessed": {
              "type": "string",
              "format": "date"
            }
          }
        },
        "rule_summary": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "expected_verdict": {
      "enum": [
        "compliant",
        "non_compliant",
        "indeterminate",
        "out_of_scope"
      ]
    },
    "methods": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generated_by", "generated_on"],
      "properties": {
        "generated_by": {
          "type": "string"
        },
        "generated_on": {
          "type": "string",
          "format": "date"
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
