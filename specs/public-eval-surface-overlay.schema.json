{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/thefazzer/bankingops-coverage-grid/blob/main/specs/public-eval-surface-overlay.schema.json",
  "title": "BOCG public-eval surface overlay",
  "description": "Release-pinned projection of public rubrics, benchmarks and evals onto the SPEC-08 episode-surface depth ladder. Carries identifiers, mapping status, likelihood band and rationales only. Never institution instances, private corpora, BOCG cell-citation coverage as eval density, or competency scores.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "bocg_release", "method", "inventory_sha256", "rows", "division_rollup"],
  "properties": {
    "schema": {"const": "bocg.public-eval-surface-overlay/v1"},
    "bocg_release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag", "task_concepts_sha256"],
      "properties": {
        "tag": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "task_concepts_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rules_version", "paint_statuses", "band_weights", "channels_in_saturation", "paint_inventory_classes", "llmaj_prereg_sha256"],
      "properties": {
        "rules_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "paint_statuses": {
          "type": "array",
          "minItems": 1,
          "items": {"enum": ["QUALIFIED_MAPPING", "RATIFIED_MAPPING"]}
        },
        "band_weights": {
          "type": "object",
          "additionalProperties": false,
          "required": ["L1", "L2", "L3"],
          "properties": {
            "L1": {"type": "integer", "minimum": 1},
            "L2": {"type": "integer", "minimum": 1},
            "L3": {"type": "integer", "minimum": 1}
          }
        },
        "channels_in_saturation": {
          "type": "array",
          "minItems": 1,
          "items": {"enum": ["public"]}
        },
        "paint_inventory_classes": {
          "type": "array",
          "minItems": 1,
          "items": {"enum": ["peer_framework", "peer_task_shape", "public_benchmark", "public_rubric"]}
        },
        "llmaj_prereg_sha256": {
          "description": "Front-loaded public-eval LLMAJ prereg digest. Band weights, channels, and public_benchmark paint must bind to this pack.",
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "inventory_sha256": {"$ref": "#/$defs/sha256"},
    "rows": {
      "type": "array",
      "items": {"$ref": "#/$defs/row"}
    },
    "division_rollup": {
      "description": "Deterministic per-division roll-up of painted public-eval rows. Derived; must match tools/public_eval_overlay.py.",
      "type": "object",
      "additionalProperties": false,
      "required": ["grain", "band_weights", "divisions", "summary"],
      "properties": {
        "grain": {"const": "division"},
        "band_weights": {
          "type": "object",
          "additionalProperties": false,
          "required": ["L1", "L2", "L3"],
          "properties": {
            "L1": {"type": "integer"},
            "L2": {"type": "integer"},
            "L3": {"type": "integer"}
          }
        },
        "divisions": {
          "type": "array",
          "items": {"$ref": "#/$defs/division_cell"}
        },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["admitted_divisions", "painted_divisions", "void_divisions", "painted_rows", "max_saturation"],
          "properties": {
            "admitted_divisions": {"type": "integer", "minimum": 1},
            "painted_divisions": {"type": "integer", "minimum": 0},
            "void_divisions": {"type": "integer", "minimum": 0},
            "painted_rows": {"type": "integer", "minimum": 0},
            "max_saturation": {"type": "integer", "minimum": 0}
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "depth": {"enum": ["division", "function_concept", "task_concept", "terminal_task", "control_point"]},
    "mapping_status": {"enum": ["PROPOSED", "PENDING", "RATIFIED_MAPPING", "QUALIFIED_MAPPING", "REJECTED_MAPPING", "DEFERRED_MAPPING"]},
    "band": {"enum": ["L1", "L2", "L3"]},
    "rule_id": {"enum": ["R-DIV-KEY", "R-TERM-TASK", "R-CONCEPT", "R-CTRL-CITE", "R-PEER-SHAPE", "R-REJECT"]},
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_id", "inventory_id", "channel", "division_key", "depth", "mapping_status",
        "band", "rule_id", "function_concept_id", "task_concept_id", "task_reference_id",
        "control_point_id", "rationale", "ruling"
      ],
      "properties": {
        "row_id": {"type": "string", "pattern": "^ovr_[a-z0-9_]+$"},
        "inventory_id": {"type": "string", "minLength": 3},
        "channel": {"enum": ["public", "own_cell", "own_artifact"]},
        "division_key": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^[a-z0-9_]+$"}]},
        "depth": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/depth"}]},
        "mapping_status": {"$ref": "#/$defs/mapping_status"},
        "band": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/band"}]},
        "rule_id": {"$ref": "#/$defs/rule_id"},
        "function_concept_id": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^function_concept:[a-z0-9_]+:[0-9a-f]{24}$"}]},
        "task_concept_id": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^task_concept:[a-z0-9_]+:[0-9a-f]{24}$"}]},
        "task_reference_id": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^task:[a-z0-9_]+:[0-9a-f]{24}$"}]},
        "control_point_id": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^cp_[a-z0-9_]+$"}]},
        "llmaj_pass_ref": {
          "description": "Required for public_benchmark QUALIFIED/RATIFIED paint: case_id from reference/public-eval-llmaj-ledger.v1.json that passed primary+sensitivity intersection-union. Forbidden as a one-pass owner substitute.",
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^llmaj_[a-z0-9_]+$"}
          ]
        },
        "rationale": {"type": "string", "minLength": 20},
        "ruling": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["ruled_at", "ruled_by_role"],
              "properties": {
                "ruled_at": {"type": "string", "format": "date"},
                "ruled_by_role": {"enum": ["owner", "sme", "second_reviewer"]}
              }
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"mapping_status": {"enum": ["QUALIFIED_MAPPING", "RATIFIED_MAPPING"]}}},
          "then": {
            "properties": {
              "division_key": {"type": "string"},
              "depth": {"type": "string"},
              "band": {"type": "string"},
              "ruling": {"type": "object"},
              "channel": {"const": "public"}
            }
          }
        },
        {
          "if": {"properties": {"depth": {"const": "function_concept"}}},
          "then": {"properties": {"function_concept_id": {"type": "string"}}}
        },
        {
          "if": {"properties": {"depth": {"const": "task_concept"}}},
          "then": {"properties": {"task_concept_id": {"type": "string"}}}
        },
        {
          "if": {"properties": {"depth": {"const": "terminal_task"}}},
          "then": {"properties": {"task_reference_id": {"type": "string"}}}
        },
        {
          "if": {"properties": {"depth": {"const": "control_point"}}},
          "then": {"properties": {"control_point_id": {"type": "string"}}}
        }
      ]
    },
    "division_cell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["division_key", "review_status", "matrix_tier", "painted_rows", "saturation", "void", "row_ids"],
      "properties": {
        "division_key": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "review_status": {"enum": ["AUTO", "REVIEWED"]},
        "matrix_tier": {"enum": ["STRONG", "MODERATE", "WEAK", "UNKNOWN"]},
        "painted_rows": {"type": "integer", "minimum": 0},
        "saturation": {"type": "integer", "minimum": 0},
        "void": {"type": "boolean"},
        "row_ids": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
