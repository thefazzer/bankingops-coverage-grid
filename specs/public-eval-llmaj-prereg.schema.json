{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/thefazzer/bankingops-coverage-grid/blob/main/specs/public-eval-llmaj-prereg.schema.json",
  "title": "BOCG public-eval LLMAJ preregistration pack",
  "description": "Front-loaded, hash-bound parameters for public-eval LLMAJ mapping. Observable frozen prompt; no per-artifact prompt variants; no owner-steered relative saturation; no seller own-coverage in judge context.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "locked_at",
    "observable_prompt",
    "rubric",
    "inputs",
    "panel",
    "pass_rule_ref",
    "band_weights",
    "channels_in_saturation",
    "paint_inventory_classes",
    "non_influence",
    "candidate_policy",
    "prereg_sha256"
  ],
  "properties": {
    "schema": {"const": "bocg.public-eval-llmaj-prereg/v1"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "locked_at": {"type": "string", "format": "date"},
    "observable_prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "placeholders"],
      "properties": {
        "path": {"type": "string"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "placeholders": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        },
        "notes": {"type": "string"}
      }
    },
    "rubric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "id", "version", "sha256"],
      "properties": {
        "path": {"type": "string"},
        "id": {"const": "bocg-public-eval-mapping"},
        "version": {"type": "string"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inventory_path",
        "inventory_sha256",
        "catalogue_path",
        "catalogue_sha256",
        "task_concepts_sha256",
        "inventory_classes_in_scope"
      ],
      "properties": {
        "inventory_path": {"type": "string"},
        "inventory_sha256": {"$ref": "#/$defs/sha256"},
        "catalogue_path": {"type": "string"},
        "catalogue_sha256": {"$ref": "#/$defs/sha256"},
        "task_concepts_sha256": {"$ref": "#/$defs/sha256"},
        "inventory_classes_in_scope": {
          "type": "array",
          "items": {"const": "public_benchmark"}
        }
      }
    },
    "panel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assessors", "models", "call"],
      "properties": {
        "assessors": {
          "type": "array",
          "minItems": 2,
          "items": {"enum": ["judge-primary", "judge-sensitivity"]}
        },
        "models": {
          "type": "object",
          "additionalProperties": false,
          "required": ["judge-primary", "judge-sensitivity"],
          "description": "Front-loaded model ids for each assessor. Must be distinct vendor families.",
          "properties": {
            "judge-primary": {"type": "string", "minLength": 3},
            "judge-sensitivity": {"type": "string", "minLength": 3}
          }
        },
        "call": {
          "type": "object",
          "additionalProperties": false,
          "required": ["temperature", "top_p", "max_tokens", "seed_base"],
          "properties": {
            "temperature": {"type": "number"},
            "top_p": {"type": "number"},
            "max_tokens": {"type": "integer"},
            "seed_base": {"type": "integer"}
          }
        }
      }
    },
    "pass_rule_ref": {"const": "public-eval-mapping/intersection-union/v1"},
    "band_weights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["L1", "L2", "L3"],
      "properties": {
        "L1": {"type": "integer"},
        "L2": {"type": "integer"},
        "L3": {"type": "integer"}
      }
    },
    "channels_in_saturation": {
      "type": "array",
      "minItems": 1,
      "items": {"const": "public"}
    },
    "paint_inventory_classes": {
      "type": "array",
      "items": {"enum": ["peer_framework", "peer_task_shape", "public_benchmark", "public_rubric"]}
    },
    "non_influence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relative_public_eval_saturation",
        "seller_own_coverage",
        "forbidden_context_paths",
        "forbidden_channels_in_judge_context",
        "owner_authored_candidate_rows",
        "per_artifact_prompt_variants",
        "post_hoc_band_weight_changes"
      ],
      "properties": {
        "relative_public_eval_saturation": {"const": "forbidden_to_steer"},
        "seller_own_coverage": {"const": "forbidden_to_steer"},
        "forbidden_context_paths": {"type": "array", "items": {"type": "string"}},
        "forbidden_channels_in_judge_context": {
          "type": "array",
          "items": {"enum": ["own_cell", "own_artifact"]}
        },
        "owner_authored_candidate_rows": {"const": "forbidden"},
        "per_artifact_prompt_variants": {"const": "forbidden"},
        "post_hoc_band_weight_changes": {"const": "forbidden_without_new_prereg"}
      }
    },
    "candidate_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "description"],
      "properties": {
        "mode": {"const": "llmaj_output_only"},
        "description": {"type": "string", "minLength": 20}
      }
    },
    "prereg_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
