{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bankingops.example/schemas/control-point-cell.schema.json",
  "title": "BOCG control-point cell",
  "type": "object",
  "required": ["cell_id", "division_key", "job_function", "control_point",
               "citations", "consequence_anchor", "commonality_rationale", "status", "methods"],
  "additionalProperties": false,
  "properties": {
    "cell_id": {"type": "string", "pattern": "^cp_[a-z0-9_]{3,64}$"},
    "division_key": {"type": "string", "description": "SPEC-01 admitted division key"},
    "job_function": {"type": "string", "minLength": 3},
    "control_point": {"type": "string", "minLength": 10,
      "description": "WHAT is controlled and WHO governs it - never desk-level HOW (S3-I4)"},
    "citations": {
      "type": "array", "minItems": 1,
      "items": {"type": "object",
        "required": ["source_name", "url", "clause", "accessed"],
        "additionalProperties": false,
        "properties": {
          "source_name": {"type": "string"},
          "url": {"type": "string", "pattern": "^https?://"},
          "clause": {"type": "string", "description": "article/section/rule identifier"},
          "accessed": {"type": "string", "format": "date"}
        }}},
    "consequence_anchor": {
      "type": "object",
      "required": ["failure_class", "public_source", "magnitude_band"],
      "additionalProperties": false,
      "properties": {
        "failure_class": {"enum": ["settlement_fail_penalty", "regulatory_fine",
          "client_asset_breach", "reconciliation_remediation", "mispayment",
          "margin_dispute", "reporting_rejection"]},
        "public_source": {"type": "string", "description": "the citable regime/precedent pricing this failure"},
        "magnitude_band": {"type": "string",
          "description": "qualitative or sourced band; invented precision prohibited (S3-G2)"}
      }},
    "commonality_rationale": {"type": "string", "minLength": 20,
      "description": "why this control point is operationally common - public evidence only"},
    "status": {"enum": ["PROPOSED", "CURATED", "RETIRED"]},
    "methods": {
      "type": "object",
      "required": ["generated_by", "generated_on", "curated_by"],
      "additionalProperties": false,
      "properties": {
        "generated_by": {"type": "string", "description": "model id or 'human'"},
        "generated_on": {"type": "string", "format": "date"},
        "curated_by": {"type": ["string", "null"], "description": "null while status:PROPOSED"}
      }}
  }
}
